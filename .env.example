ANTHROPIC_API_KEY=your-key-here

# RAG (opcional, mas recomendado) — base de conhecimento arquitetônico
# Voyage AI embeddings (https://www.voyageai.com/)
VOYAGE_API_KEY=
# Supabase com pgvector (https://supabase.com/)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Senha do endpoint POST /api/seed (popula a base)
SEED_SECRET=

# Pipeline híbrido (opcional) — geração de planta via GPT Image + Arrow
# OpenAI API key para gpt-image-1 (geração de imagens)
OPENAI_API_KEY=
# Quiver AI API key para Arrow 1.1 (vetorização — opcional, apenas exportação)
QUIVER_API_KEY=
# Habilita o pipeline híbrido (default: false)
HYBRID_PIPELINE_ENABLED=false
